{
  "name": "rest-server",
  "version": "1.0.0",
  "description": "A small REST API backend built with Express, TypeScript, and MongoDB.",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "heroku-postbuild": "npm run build"
  },
  "keywords": [
    "rest",
    "api",
    "express",
    "typescript",
    "mongodb",
    "backend"
  ],
  "author": "Utsab Adhikari",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/utsab-adhikari/rest-server.git"
  },
  "homepage": "https://rest.utsab.space",
  "bugs": {
    "url": "https://github.com/utsab-adhikari/rest-server/issues"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.3",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}